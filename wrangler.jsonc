{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "christianscienceaurora",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match "name" above.
      // See https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "christianscienceaurora"
    }
  ],
  // Workers Cache: responses that are marked cacheable (all prerendered pages) are served
  // from Cloudflare's cache without invoking the Worker at all. Cache entries are keyed by
  // Worker version, so a deploy automatically serves fresh content.
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  }
}
